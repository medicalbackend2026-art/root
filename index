              <option value="All">All</option>
              <option value="Fixed Rent" style={{ background:"#0d1b2a" }}>Fixed Rent</option>
              <option value="Profit Sharing" style={{ background:"#0d1b2a" }}>Profit Sharing</option>
            </select>
          </div>
        </div>
        <div>
          <label style={{ fontSize:10, color:B.muted, display:"block", marginBottom:7, fontWeight:700 }}>✅ MUST-HAVE FACILITIES</label>
          <div style={{ display:"flex", gap:6, flexWrap:"wrap" }}>
            {["Nurse on duty","Lab on-site","Pharmacy","Parking","Marketing support","Minor OT","X-Ray","Generator backup"].map(f=>(
              <button key={f} onClick={()=>toggleFindFacility(f)} style={{ padding:"4px 11px", borderRadius:20, fontSize:11, border:"none", cursor:"pointer", fontFamily:"inherit",
                background:fFacility.includes(f)?B.primary:"rgba(255,255,255,0.05)", color:fFacility.includes(f)?"#030B14":B.muted }}>{f}</button>
            ))}
          </div>
        </div>
      </div>

      {/* Listing cards */}
      <div style={{ display:"flex", flexDirection:"column", gap:14 }}>
        {filtered.map(c=>(
          <div key={c.id} style={{ ...card(), cursor:"pointer", transition:"all 0.2s" }}
            onMouseEnter={e=>{ e.currentTarget.style.borderColor=B.primary; e.currentTarget.style.transform="translateY(-2px)"; }}
            onMouseLeave={e=>{ e.currentTarget.style.borderColor=B.border; e.currentTarget.style.transform="translateY(0)"; }}>
            <div style={{ display:"flex", gap:12, alignItems:"flex-start" }}>
              {/* Photo strip */}
              <div style={{ display:"flex", flexDirection:"column", gap:4, flexShrink:0 }}>
                {c.photos.slice(0,2).map((p,i)=>(
                  <div key={i} style={{ width:52, height:52, borderRadius:9, background:`rgba(${rgb(B.primary)},0.15)`, display:"flex", alignItems:"center", justifyContent:"center", fontSize:22 }}>{p}</div>
                ))}
                {c.photos.length>2 && <div style={{ width:52, height:22, borderRadius:6, background:"rgba(255,255,255,0.06)", display:"flex", alignItems:"center", justifyContent:"center", fontSize:10, color:B.muted }}>+{c.photos.length-2}</div>}
              </div>
              {/* Info */}
              <div style={{ flex:1, minWidth:0 }}>
                <div style={{ display:"flex", justifyContent:"space-between", alignItems:"flex-start", flexWrap:"wrap", gap:8 }}>
                  <div>
                    <div style={{ fontSize:15, fontWeight:800 }}>{c.name}</div>
                    <div style={{ fontSize:12, color:B.muted }}>📍 {c.area}, {c.city}</div>
                  </div>
                  <div style={{ textAlign:"right" }}>
                    {c.rentType==="Profit Sharing"
                      ? <div style={{ fontSize:14, fontWeight:800, color:"#A855F7" }}>Profit Share</div>
                      : <div style={{ fontSize:16, fontWeight:900, color:B.primary }}>₹{c.rent?.toLocaleString("en-IN")}<span style={{ fontSize:11, color:B.muted, fontWeight:400 }}>/mo</span></div>
                    }
                  </div>
                </div>
                <div style={{ display:"flex", gap:6, flexWrap:"wrap", margin:"8px 0" }}>
                  <span style={{ ...bdge(c.type==="Complete Clinic"?B.accent:B.primary), fontSize:10 }}>{c.type}</span>
                  <span style={{ ...bdge("#F59E0B"), fontSize:10 }}>👥 ~{c.avgFootfall}/day</span>
                  <span style={{ ...bdge(B.border), fontSize:10 }}>⭐ {c.rating}</span>
                  {c.sharingDoctors.length>0 && <span style={{ ...bdge("#8B5CF6"), fontSize:10 }}>{c.sharingDoctors.length} doctor{c.sharingDoctors.length>1?"s":""} sharing</span>}
                </div>
                <div style={{ display:"flex", gap:5, flexWrap:"wrap", marginBottom:10 }}>
                  {c.tags.map(t=><span key={t} style={{ fontSize:10, color:B.muted, background:"rgba(255,255,255,0.04)", border:`1px solid ${B.border}`, borderRadius:5, padding:"2px 7px" }}>{t}</span>)}
                </div>
                <button onClick={()=>setViewListing(c)} style={{ ...btn(B.primary), fontSize:12, padding:"7px 16px" }}>View Details & Photos →</button>
              </div>
            </div>
          </div>
        ))}
        {filtered.length===0 && (
          <div style={{ ...card(), textAlign:"center", padding:40 }}>
            <div style={{ fontSize:36, marginBottom:10 }}>🏥</div>
            <div style={{ fontSize:14, color:B.muted }}>No spaces match your filters. Try adjusting city or facility requirements.</div>
          </div>
        )}
      </div>
    </div>
  );

  // ── LIST mode ──
  if (mode==="list") {
    if (lPosted) return (
      <div style={{ textAlign:"center", padding:"50px 20px" }}>
        <div style={{ fontSize:60, marginBottom:14 }}>🎉</div>
        <h2 style={{ fontSize:20, fontWeight:800, color:B.accent }}>Clinic Listed Successfully!</h2>
        <p style={{ color:B.muted, fontSize:13, margin:"10px 0 20px" }}><strong style={{ color:"#FFF" }}>{lForm.clinicName}</strong> in {lForm.area}, {lForm.city} is now live.</p>
        <p style={{ color:B.muted, fontSize:12 }}>Verified doctors searching in your area will be notified within 2 hours.</p>
        <div style={{ display:"flex", gap:10, justifyContent:"center", marginTop:20 }}>
          <button onClick={()=>{setLPosted(false);setLStep(0);setMode(null);}} style={{ ...btn(B.accent), fontSize:13 }}>← Back to Services</button>
        </div>
      </div>
    );

    const STEP_LABELS = ["Clinic Info","Facilities & Timing","Pricing & Photos","Review & Post"];
    return (
      <div>
        <button onClick={()=>lStep===0?setMode(null):setLStep(lStep-1)} style={{ background:"none",border:"none",color:B.primary,cursor:"pointer",fontSize:13,marginBottom:16,padding:0,fontFamily:"inherit" }}>
          ← {lStep===0?"Back":"Previous"}
        </button>
        <div style={{ marginBottom:20 }}>
          <div style={{ fontSize:10, letterSpacing:4, color:B.accent, textTransform:"uppercase", marginBottom:4 }}>List Your Clinic</div>
          <h2 style={{ fontSize:20, fontWeight:800, margin:0 }}>Rent Out Your Space</h2>
        </div>

        {/* Steps */}
        <div style={{ display:"flex", alignItems:"center", marginBottom:24 }}>
          {STEP_LABELS.map((s,i)=>(
