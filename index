        {[["🏥","320+ clinics","listed across India"],["👨‍⚕️","1,400+ doctors","found spaces via Corvallis"],["⭐","4.6/5 avg","owner satisfaction rating"],["⚡","48 hrs","avg time to first enquiry"]].map(([i,v,l])=>(
