// ── CHAT COMPONENT (shared between doctor/nurse/admin) ─────────────
// ═══════════════════════════════════════════════════════════════════
function ChatWindow({ app, senderRole, onClose, onSend, isMobile }) {
  const [text, setText] = useState("");
  const bottomRef = useRef(null);
  useEffect(() => { bottomRef.current?.scrollIntoView({ behavior:"smooth" }); }, [app.msgs]);

  const senderLabel = senderRole === "clinic" ? "clinic" : senderRole === "admin" ? "admin" : "nurse";

  function send() {
    if (!text.trim()) return;
    onSend(app.id, { from: senderLabel, text: text.trim(), time: now() });
    setText("");
  }

  const bubbleColor = { clinic: B.primary, nurse: B.nurse, admin: B.admin, system: B.muted };

  return (
    <div style={{
      position: isMobile ? "fixed" : "relative",
      inset: isMobile ? 0 : "auto",
      zIndex: isMobile ? 999 : "auto",
      background: B.bg,
      display: "flex", flexDirection: "column",
      height: isMobile ? "100vh" : 420,
      borderRadius: isMobile ? 0 : 16,
      border: `1px solid rgba(${rgb(B.nurse)},0.3)`,
      overflow: "hidden",
    }}>
      {/* Header */}
      <div style={{ padding:"14px 16px", background:`rgba(${rgb(B.nurse)},0.1)`, borderBottom:`1px solid ${B.border}`, display:"flex", justifyContent:"space-between", alignItems:"center" }}>
        <div>
          <div style={{ fontSize:14, fontWeight:700 }}>{app.nurse}</div>
          <div style={{ fontSize:11, color:B.muted }}>{app.role} · {app.clinic} · {app.city}</div>
        </div>
        <div style={{ display:"flex", gap:8, alignItems:"center" }}>
          <Pill label={app.status} color={app.status==="Hired"?B.accent:app.status==="Shortlisted"?B.primary:app.status==="Rejected"?B.danger:B.warn}/>
          {onClose && <button onClick={onClose} style={{ background:"none", border:"none", color:B.muted, cursor:"pointer", fontSize:18, lineHeight:1 }}>×</button>}
        </div>
      </div>

      {/* Messages */}
      <div style={{ flex:1, overflowY:"auto", padding:"14px 16px", display:"flex", flexDirection:"column", gap:10 }}>
        {app.msgs.map((m,i) => {
          const isMe = m.from === senderLabel;
          const isSystem = m.from === "system";
          if (isSystem) return (
            <div key={i} style={{ textAlign:"center", fontSize:11, color:B.muted, padding:"4px 12px", background:"rgba(255,255,255,0.04)", borderRadius:20, alignSelf:"center" }}>{m.text}</div>
          );
          return (
            <div key={i} style={{ display:"flex", justifyContent:isMe?"flex-end":"flex-start", gap:8 }}>
              {!isMe && <div style={{ width:26,height:26,borderRadius:"50%",background:`rgba(${rgb(bubbleColor[m.from]||B.muted)},0.2)`,display:"flex",alignItems:"center",justifyContent:"center",fontSize:12,flexShrink:0,alignSelf:"flex-end" }}>{m.from==="clinic"?"🏥":m.from==="admin"?"⚙️":"👩‍⚕️"}</div>}
              <div>
                <div style={{ maxWidth:260, padding:"10px 14px", borderRadius:isMe?"16px 16px 4px 16px":"16px 16px 16px 4px",
                  background:isMe?`linear-gradient(135deg,${bubbleColor[m.from]||B.primary},${bubbleColor[m.from]||B.primary}cc)`:"rgba(255,255,255,0.07)",
                  color:isMe?"#030B14":B.text, fontSize:13, lineHeight:1.5 }}>{m.text}</div>
                <div style={{ fontSize:10, color:B.muted, marginTop:3, textAlign:isMe?"right":"left" }}>{m.time}</div>
              </div>
            </div>
          );
        })}
        <div ref={bottomRef}/>
      </div>

      {/* Input */}
      <div style={{ padding:"12px 14px", borderTop:`1px solid ${B.border}`, display:"flex", gap:9 }}>
        <input value={text} onChange={e=>setText(e.target.value)} onKeyDown={e=>e.key==="Enter"&&send()}
