        method:"POST", headers:{ "Content-Type":"application/json" },
        body: JSON.stringify({
          model:"claude-sonnet-4-20250514", max_tokens:1000, system:SYSTEM,
          messages: newMsgs.map(m=>({ role:m.role, content:m.text })),
        }),
      });
      const data = await res.json();
      const reply = data.content?.map(b=>b.text||"").join("") || "Sorry, couldn't get a response.";
      setMessages([...newMsgs, { role:"assistant", text:reply }]);
    } catch {
      setMessages([...newMsgs, { role:"assistant", text:"Connection error. Please try again." }]);
    }
