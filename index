// ── Star rating display ───────────────────────────────────────────
function Stars({ rating, color="#F59E0B" }) {
  return (
    <span style={{ color, fontSize:13, letterSpacing:1 }}>
      {"★".repeat(Math.floor(rating))}{"☆".repeat(5-Math.floor(rating))}
      <span style={{ fontSize:11, color:B.muted, marginLeft:4 }}>{rating.toFixed(1)}</span>
    </span>
  );
}

