                </div>
              ))}
              <div>
                <label style={{ fontSize:10,color:B.muted,display:"block",marginBottom:4,fontWeight:700 }}>📍 CITY *</label>
                <select value={lForm.city} onChange={e=>setLF("city",e.target.value)} style={inp}>
                  <option value="">Select city</option>
                  {CITIES.map(c=><option key={c} value={c} style={{ background:"#0d1b2a" }}>{c}</option>)}
                </select>
              </div>
              <div>
                <label style={{ fontSize:10,color:B.muted,display:"block",marginBottom:4,fontWeight:700 }}>🏥 CLINIC TYPE</label>
                <div style={{ display:"flex", gap:8 }}>
                  {["Complete Clinic","Share Clinic"].map(t=>(
                    <button key={t} onClick={()=>setLF("type",t)} style={{ flex:1, padding:"9px 8px", borderRadius:8, fontSize:11, border:"none", cursor:"pointer", fontFamily:"inherit",
                      background:lForm.type===t?B.primary:"rgba(255,255,255,0.06)", color:lForm.type===t?"#030B14":B.muted, fontWeight:lForm.type===t?700:400 }}>{t}</button>
                  ))}
                </div>
              </div>
            </div>
            <div style={{ marginTop:12, display:"grid", gridTemplateColumns:isMobile?"1fr":"1fr 1fr", gap:12 }}>
              <div>
                <label style={{ fontSize:10,color:B.muted,display:"block",marginBottom:4,fontWeight:700 }}>📐 AREA (SQ.FT)</label>
                <input type="number" value={lForm.sqft} onChange={e=>setLF("sqft",e.target.value)} placeholder="e.g. 400" style={inp}/>
              </div>
              <div>
                <label style={{ fontSize:10,color:B.muted,display:"block",marginBottom:4,fontWeight:700 }}>🚪 NO. OF ROOMS</label>
                <select value={lForm.rooms} onChange={e=>setLF("rooms",e.target.value)} style={inp}>
                  {["1","2","3","4","5","6+"].map(r=><option key={r} value={r} style={{ background:"#0d1b2a" }}>{r} room{r!=="1"?"s":""}</option>)}
                </select>
              </div>
            </div>
            <div style={{ marginTop:12 }}>
              <label style={{ fontSize:10,color:B.muted,display:"block",marginBottom:4,fontWeight:700 }}>📝 CLINIC DESCRIPTION</label>
              <textarea rows={3} value={lForm.description} onChange={e=>setLF("description",e.target.value)} placeholder="Describe location, infrastructure, patient catchment, nearby hospitals…" style={{ ...inp, resize:"vertical" }}/>
            </div>
            <button onClick={()=>setLStep(1)} disabled={!lForm.clinicName||!lForm.city||!lForm.area||!lForm.contactName||!lForm.contactPhone}
              style={{ ...btn(B.primary), marginTop:16, opacity:(!lForm.clinicName||!lForm.city||!lForm.area||!lForm.contactName||!lForm.contactPhone)?0.4:1 }}>Next →</button>
          </div>
        )}

        {lStep===1 && (
          <div style={{ maxWidth:540 }}>
            <div style={{ marginBottom:16 }}>
              <label style={{ fontSize:10,color:B.muted,display:"block",marginBottom:8,fontWeight:700 }}>✅ AVAILABLE FACILITIES (select all that apply)</label>
              <div style={{ display:"flex", gap:7, flexWrap:"wrap" }}>
                {ALL_FACILITIES.map(f=>(
                  <button key={f} onClick={()=>toggleFacility(f)} style={{ padding:"5px 12px", borderRadius:20, fontSize:11, border:"none", cursor:"pointer", fontFamily:"inherit",
                    background:lForm.facilities.includes(f)?B.accent:"rgba(255,255,255,0.05)", color:lForm.facilities.includes(f)?"#030B14":B.muted }}>{f}</button>
                ))}
              </div>
              <div style={{ display:"flex", gap:8, marginTop:10 }}>
                <input value={lForm.customFacility} onChange={e=>setLF("customFacility",e.target.value)} placeholder="Add custom facility…" style={{ ...inp, flex:1, fontSize:12 }}/>
                <button onClick={()=>{ if(lForm.customFacility.trim()){ toggleFacility(lForm.customFacility.trim()); setLF("customFacility",""); }}} style={{ ...btn(B.accent,true), padding:"8px 14px", fontSize:12 }}>+ Add</button>
              </div>
            </div>
            <div style={{ marginBottom:14 }}>
              <label style={{ fontSize:10,color:B.muted,display:"block",marginBottom:5,fontWeight:700 }}>⏰ AVAILABLE TIMINGS</label>
              <input value={lForm.timings} onChange={e=>setLF("timings",e.target.value)} placeholder="e.g. Mon–Sat 9am–1pm, Evening slot 5pm–9pm" style={inp}/>
            </div>
            <button onClick={()=>setLStep(2)} style={btn(B.primary)}>Next →</button>
          </div>
        )}

        {lStep===2 && (
          <div style={{ maxWidth:520 }}>
            <div style={{ marginBottom:16 }}>
              <label style={{ fontSize:10,color:B.muted,display:"block",marginBottom:8,fontWeight:700 }}>💰 PRICING MODEL</label>
              <div style={{ display:"flex", gap:8, marginBottom:12 }}>
                {["Fixed Rent","Profit Sharing"].map(t=>(
                  <button key={t} onClick={()=>setLF("rentType",t)} style={{ flex:1, padding:"10px", borderRadius:9, fontSize:12, border:"none", cursor:"pointer", fontFamily:"inherit",
                    background:lForm.rentType===t?B.primary:"rgba(255,255,255,0.06)", color:lForm.rentType===t?"#030B14":B.muted, fontWeight:lForm.rentType===t?700:400 }}>{t==="Fixed Rent"?"🏷️ Fixed Rent":"🤝 Profit Sharing"}</button>
                ))}
              </div>
              {lForm.rentType==="Fixed Rent"
                ? <div>
                    <label style={{ fontSize:10,color:B.muted,display:"block",marginBottom:4,fontWeight:700 }}>MONTHLY RENT (₹)</label>
                    <input type="number" value={lForm.rentAmount} onChange={e=>setLF("rentAmount",e.target.value)} placeholder="e.g. 20000" style={inp}/>
                  </div>
                : <div>
                    <label style={{ fontSize:10,color:B.muted,display:"block",marginBottom:4,fontWeight:700 }}>PROFIT SPLIT TERMS</label>
                    <input value={lForm.profitShare} onChange={e=>setLF("profitShare",e.target.value)} placeholder="e.g. 70% doctor / 30% clinic owner" style={inp}/>
                  </div>
              }
            </div>
            {/* Photo upload simulation */}
            <div style={{ marginBottom:18 }}>
              <label style={{ fontSize:10,color:B.muted,display:"block",marginBottom:8,fontWeight:700 }}>📷 CLINIC PHOTOS</label>
              <div style={{ display:"flex", gap:9, flexWrap:"wrap" }}>
                {["Reception Area","Consultation Room","Waiting Area","Equipment","Outside View"].map(label=>(
                  <div key={label} onClick={()=>{ if(!lForm.photos.includes(label)) setLF("photos",[...lForm.photos,label]); }}
                    style={{ width:90, height:80, borderRadius:10, cursor:"pointer", display:"flex", flexDirection:"column", alignItems:"center", justifyContent:"center", gap:5, fontSize:10, transition:"all 0.2s",
                      background: lForm.photos.includes(label)?`rgba(${rgb(B.primary)},0.2)`:"rgba(255,255,255,0.04)",
                      border: lForm.photos.includes(label)?`2px solid ${B.primary}`:`2px dashed ${B.border}`,
                      color: lForm.photos.includes(label)?B.primary:B.muted }}>
                    <span style={{ fontSize:22 }}>{lForm.photos.includes(label)?"✅":"📷"}</span>
                    <span style={{ textAlign:"center", lineHeight:1.3 }}>{label}</span>
                  </div>
                ))}
              </div>
              <div style={{ fontSize:11, color:B.muted, marginTop:8 }}>Click to mark photos you'll upload. Actual upload available in the app.</div>
            </div>
            <button onClick={()=>setLStep(3)} style={btn(B.primary)}>Review & Post →</button>
          </div>
        )}

        {lStep===3 && (
          <div style={{ maxWidth:500 }}>
            <div style={{ ...card(`rgba(${rgb(B.accent)},0.12)`), marginBottom:14, padding:18 }}>
              <div style={{ display:"flex", gap:12, alignItems:"center", marginBottom:14, paddingBottom:12, borderBottom:`1px solid ${B.border}` }}>
                <div style={{ fontSize:32 }}>🏥</div>
                <div>
                  <div style={{ fontSize:16, fontWeight:800 }}>{lForm.clinicName}</div>
                  <div style={{ fontSize:12, color:B.muted }}>{lForm.area}, {lForm.city} · {lForm.type}</div>
                </div>
                <div style={{ marginLeft:"auto", textAlign:"right" }}>
                  {lForm.rentType==="Fixed Rent"
                    ? <div style={{ fontSize:15, fontWeight:800, color:B.primary }}>₹{parseInt(lForm.rentAmount||0).toLocaleString("en-IN")}/mo</div>
                    : <div style={{ fontSize:13, fontWeight:700, color:"#A855F7" }}>Profit Sharing</div>
                  }
                </div>
              </div>
              {[["Rooms",lForm.rooms+" room(s)"],["Area",lForm.sqft?lForm.sqft+" sq.ft":"—"],["Timings",lForm.timings||"—"],["Facilities",lForm.facilities.length+" selected"],["Photos",lForm.photos.length+" tagged"]].map(([k,v])=>(
                <div key={k} style={{ display:"flex", justifyContent:"space-between", padding:"8px 0", borderBottom:`1px solid ${B.border}`, fontSize:12 }}>
                  <span style={{ color:B.muted }}>{k}</span><span style={{ fontWeight:600 }}>{v}</span>
                </div>
              ))}
            </div>
            <div style={{ ...card(`rgba(${rgb(B.primary)},0.1)`), marginBottom:16, padding:12 }}>
              <div style={{ fontSize:12, fontWeight:700, color:B.primary, marginBottom:5 }}>📣 Your listing will reach</div>
              <div style={{ fontSize:12, color:B.muted, lineHeight:1.7 }}>~{Math.floor(Math.random()*120+60)} verified doctors searching in <strong style={{ color:"#FFF" }}>{lForm.city}</strong>. WhatsApp notification sent within 2 hours of going live.</div>
            </div>
            <div style={{ display:"flex", gap:10 }}>
              <button onClick={()=>setLStep(2)} style={{ ...btn(B.muted,true) }}>← Edit</button>
              <button onClick={()=>setLPosted(true)} style={{ ...btn(B.accent), flex:1 }}>✓ Publish Listing</button>
            </div>
          </div>
        )}
      </div>
    );
  }
  return null;
}

