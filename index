          style={{ ...inp, flex:1, padding:"10px 13px", fontSize:13 }}/>
        <button onClick={send} disabled={!text.trim()} style={{ ...btn(B.nurse), padding:"10px 18px", opacity:text.trim()?1:0.4 }}>Send</button>
      </div>
    </div>
  );
}

