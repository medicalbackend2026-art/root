// ── QUICK AUTH ─────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════
function QuickAuth({ role, onLogin, onBack }) {
  const isMobile = useIsMobile();
  const [form, setForm] = useState({ name:"", phone:"", city:"", roleType:"" });
  const [otp, setOtp]   = useState("");
  const [sent, setSent] = useState(false);
  const [loading, setLoading] = useState(false);
  const color = role==="admin"?B.admin:role==="nurse"?B.nurse:B.primary;
  const emoji = role==="admin"?"⚙️":role==="nurse"?"👩‍⚕️":"👨‍⚕️";
  const title = role==="admin"?"Admin Panel":role==="nurse"?"Nursing Staff":"Doctor Portal";

  function sendOtp() { setLoading(true); setTimeout(()=>{ setLoading(false); setSent(true); },900); }
  function verify()  { setLoading(true); setTimeout(()=>{ setLoading(false); onLogin({ ...form, type:role, name: form.name||`${title} User` }); },600); }

  // Admin bypass
  if (role==="admin") return (
    <div style={{ minHeight:"100vh", background:B.bg, display:"flex", alignItems:"center", justifyContent:"center", padding:16, fontFamily:"'Palatino Linotype',Georgia,serif", color:B.text }}>
      <div style={{ width:"100%", maxWidth:400 }}>
        <button onClick={onBack} style={{ background:"none", border:"none", color:B.muted, cursor:"pointer", fontSize:13, marginBottom:22, padding:0, fontFamily:"inherit" }}>← Back</button>
        <div style={{ ...card(`rgba(${rgb(B.admin)},0.2)`), padding:28 }}>
          <div style={{ textAlign:"center", marginBottom:22 }}>
            <div style={{ fontSize:44, marginBottom:8 }}>⚙️</div>
            <div style={{ fontSize:20, fontWeight:800 }}>Admin Access</div>
            <div style={{ fontSize:13, color:B.muted, marginTop:4 }}>Corvallis Operations Panel</div>
          </div>
          <input placeholder="Admin Username" style={{ ...inp, marginBottom:12 }} onChange={e=>setForm({...form,name:e.target.value})}/>
          <input type="password" placeholder="Password" style={{ ...inp, marginBottom:20 }}/>
          <button onClick={()=>onLogin({ name:"Admin", type:"admin" })} style={{ ...btn(B.admin), width:"100%", padding:"13px", fontSize:14 }}>Enter Admin Panel →</button>
        </div>
      </div>
    </div>
  );

  return (
    <div style={{ minHeight:"100vh", background:B.bg, display:"flex", alignItems:"center", justifyContent:"center", padding:16, fontFamily:"'Palatino Linotype',Georgia,serif", color:B.text }}>
      <div style={{ width:"100%", maxWidth:420 }}>
        <button onClick={onBack} style={{ background:"none", border:"none", color:B.muted, cursor:"pointer", fontSize:13, marginBottom:22, padding:0, fontFamily:"inherit" }}>← Back</button>
        <div style={{ display:"flex", alignItems:"center", gap:10, marginBottom:24 }}>
          <Logo size={34}/><div><div style={{ fontSize:17, fontWeight:800 }}>Corvallis <span style={{ color }}>{emoji} {role==="nurse"?"Staff":"Doctor"}</span></div><div style={{ fontSize:11, color:B.muted }}>{title}</div></div>
        </div>
        <div style={{ ...card(`rgba(${rgb(color)},0.18)`), padding:26 }}>
          {!sent ? (
            <>
              {[["Full Name","name","text"],["WhatsApp Number","phone","tel"]].map(([l,k,t])=>(
                <div key={k} style={{ marginBottom:13 }}>
                  <label style={{ fontSize:11, color:B.muted, display:"block", marginBottom:5, letterSpacing:0.5 }}>{l}</label>
                  <input type={t} value={form[k]} onChange={e=>setForm({...form,[k]:e.target.value})} style={inp}/>
                </div>
              ))}
              <div style={{ marginBottom:13 }}>
                <label style={{ fontSize:11, color:B.muted, display:"block", marginBottom:5 }}>City</label>
                <select value={form.city} onChange={e=>setForm({...form,city:e.target.value})} style={inp}>
                  <option value="">Select city</option>
                  {CITIES.map(c=><option key={c} value={c} style={{ background:"#0d1b2a" }}>{c}</option>)}
                </select>
              </div>
              {role==="nurse" && (
                <div style={{ marginBottom:13 }}>
                  <label style={{ fontSize:11, color:B.muted, display:"block", marginBottom:5 }}>Role</label>
                  <select value={form.roleType} onChange={e=>setForm({...form,roleType:e.target.value})} style={inp}>
                    <option value="">Select role</option>
                    {ROLES.map(r=><option key={r} value={r} style={{ background:"#0d1b2a" }}>{r}</option>)}
                  </select>
                </div>
              )}
              <button onClick={sendOtp} disabled={loading} style={{ ...btn(color), width:"100%", padding:"12px", marginTop:6, opacity:loading?0.6:1 }}>
                {loading?"Sending OTP…":"Send OTP on WhatsApp 📲"}
              </button>
            </>
          ) : (
            <div>
              <div style={{ textAlign:"center", marginBottom:20 }}>
                <div style={{ fontSize:34 }}>📱</div>
                <div style={{ fontSize:14, fontWeight:700, marginTop:8 }}>OTP Sent to +91 {form.phone}</div>
              </div>
              <input type="number" placeholder="Enter 4-digit OTP" value={otp} onChange={e=>setOtp(e.target.value)}
                style={{ ...inp, textAlign:"center", fontSize:22, letterSpacing:8, fontWeight:700, marginBottom:14 }}/>
              <button onClick={verify} disabled={loading||otp.length<4} style={{ ...btn(color), width:"100%", padding:"12px", opacity:(loading||otp.length<4)?0.5:1 }}>
                {loading?"Verifying…":"Verify & Enter →"}
              </button>
              <button onClick={()=>setSent(false)} style={{ ...btn(B.muted,true), width:"100%", padding:"9px", fontSize:12, marginTop:9 }}>← Change Number</button>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

