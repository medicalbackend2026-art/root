      {/* Desktop sidebar */}
      {!isMobile && (
        <div style={{ width:210, minHeight:"100vh", background:"rgba(255,255,255,0.025)", borderRight:`1px solid ${B.border}`, display:"flex", flexDirection:"column", position:"sticky", top:0, flexShrink:0 }}>
          <div style={{ padding:"18px 18px 14px", borderBottom:`1px solid ${B.border}`, marginBottom:8 }}>
            <div style={{ display:"flex", alignItems:"center", gap:9 }}><Logo size={28}/><div style={{ fontSize:14, fontWeight:800 }}>Corvallis <span style={{ color:B.nurse }}>Staff</span></div></div>
            <div style={{ fontSize:10, color:B.muted, marginTop:4 }}>Nursing Portal</div>
          </div>
          {NAV.map(n=>(
            <button key={n.id} onClick={()=>setTab(n.id)} style={{ display:"flex", alignItems:"center", gap:10, padding:"10px 18px", cursor:"pointer", fontSize:13, fontWeight:tab===n.id?700:400, color:tab===n.id?B.nurse:B.muted, background:tab===n.id?`rgba(${rgb(B.nurse)},0.09)`:"none", borderLeft:tab===n.id?`3px solid ${B.nurse}`:"3px solid transparent", border:"none", width:"100%", textAlign:"left", fontFamily:"inherit" }}>
              <span>{n.icon}</span>{n.label}
              {n.id==="messages"&&unreadTotal>0&&<span style={{ marginLeft:"auto",background:B.danger,color:"#FFF",borderRadius:"50%",width:17,height:17,display:"flex",alignItems:"center",justifyContent:"center",fontSize:9,fontWeight:700 }}>{unreadTotal}</span>}
            </button>
          ))}
          <div style={{ flex:1 }}/>
          <div style={{ padding:"14px 18px" }}>
            <div style={{ fontSize:12, fontWeight:700 }}>{user.name}</div>
            <div style={{ fontSize:10, color:B.muted, marginBottom:10 }}>{user.roleType||"Nursing Staff"} · {user.city}</div>
            <button onClick={onLogout} style={{ ...btn(B.muted,true), width:"100%", padding:"7px", fontSize:11 }}>Sign Out</button>
          </div>
        </div>
      )}

      {/* Content */}
      <div style={{ flex:1, padding:isMobile?"14px 14px 80px":"22px 24px", overflowX:"hidden" }}>
        {isMobile && (
          <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:16 }}>
            <div style={{ display:"flex", alignItems:"center", gap:8 }}><Logo size={26}/><span style={{ fontSize:14, fontWeight:800 }}>Corvallis <span style={{ color:B.nurse }}>Staff</span></span></div>
            <button onClick={onLogout} style={{ ...btn(B.muted,true), padding:"6px 10px", fontSize:11 }}>Out</button>
          </div>
        )}

        {/* JOBS */}
        {tab==="jobs" && !applyJob && (
          <div>
            {/* Header */}
            <div style={{ marginBottom:14 }}>
              <h2 style={{ fontSize:20, fontWeight:800, margin:0 }}>Find Jobs</h2>
              <p style={{ color:B.muted, fontSize:12, margin:"4px 0 0" }}>{visible.length} openings across India</p>
            </div>

            {/* Search bar + filter toggle */}
            <div style={{ display:"flex", gap:9, marginBottom:12 }}>
              <input value={filters.search} onChange={e=>setF("search",e.target.value)}
                placeholder="🔍  Search role, clinic or city…"
                style={{ ...inp, flex:1, fontSize:13 }}/>
              <button onClick={()=>setF("showFilters",!filters.showFilters)}
                style={{ ...btn(filters.showFilters?B.nurse:B.muted, true), padding:"10px 16px", fontSize:12, position:"relative", flexShrink:0 }}>
                ⚙️ Filters
                {activeFilterCount>0 && <span style={{ position:"absolute",top:-6,right:-6,background:B.danger,color:"#FFF",borderRadius:"50%",width:17,height:17,display:"flex",alignItems:"center",justifyContent:"center",fontSize:9,fontWeight:700 }}>{activeFilterCount}</span>}
              </button>
            </div>

            {/* Quick category pills always visible */}
            <div style={{ display:"flex", gap:6, flexWrap:"wrap", marginBottom:10 }}>
              {ALL_CATS.map(c=>(
                <button key={c} onClick={()=>setF("category",c)} style={{ padding:"4px 12px", borderRadius:20, fontSize:11, border:"none", cursor:"pointer", fontFamily:"inherit",
                  background:filters.category===c?B.nurse:"rgba(255,255,255,0.05)", color:filters.category===c?"#030B14":B.muted, fontWeight:filters.category===c?700:400 }}>{c}</button>
              ))}
            </div>

            {/* Expandable filter panel */}
            {filters.showFilters && (
              <div style={{ ...card(`rgba(${rgb(B.nurse)},0.12)`), marginBottom:14, padding:18 }}>
                <div style={{ display:"grid", gridTemplateColumns:isMobile?"1fr 1fr":"repeat(3,1fr)", gap:12, marginBottom:14 }}>

                  {/* City */}
                  <div>
                    <label style={{ fontSize:10, color:B.muted, display:"block", marginBottom:5, fontWeight:700, letterSpacing:0.5 }}>📍 CITY</label>
                    <select value={filters.city} onChange={e=>setF("city",e.target.value)} style={{ ...inp, fontSize:12, padding:"8px 10px" }}>
                      <option value="All">All Cities</option>
                      {CITIES.map(c=><option key={c} value={c} style={{ background:"#0d1b2a" }}>{c}</option>)}
                    </select>
                  </div>

                  {/* Role */}
                  <div>
                    <label style={{ fontSize:10, color:B.muted, display:"block", marginBottom:5, fontWeight:700, letterSpacing:0.5 }}>👤 ROLE</label>
                    <select value={filters.role} onChange={e=>setF("role",e.target.value)} style={{ ...inp, fontSize:12, padding:"8px 10px" }}>
                      {ALL_ROLES.map(r=><option key={r} value={r} style={{ background:"#0d1b2a" }}>{r}</option>)}
                    </select>
                  </div>

                  {/* Shift */}
                  <div>
                    <label style={{ fontSize:10, color:B.muted, display:"block", marginBottom:5, fontWeight:700, letterSpacing:0.5 }}>⏰ DUTY HOURS / SHIFT</label>
                    <select value={filters.shift} onChange={e=>setF("shift",e.target.value)} style={{ ...inp, fontSize:12, padding:"8px 10px" }}>
                      {ALL_SHIFTS.map(s=><option key={s} value={s} style={{ background:"#0d1b2a" }}>{s==="All"?"Any Shift":s}</option>)}
                    </select>
                  </div>

                  {/* Pay min */}
                  <div>
                    <label style={{ fontSize:10, color:B.muted, display:"block", marginBottom:5, fontWeight:700, letterSpacing:0.5 }}>💰 MIN PAY (₹/mo)</label>
                    <input type="number" placeholder="e.g. 15000" value={filters.payMin} onChange={e=>setF("payMin",e.target.value)}
                      style={{ ...inp, fontSize:12, padding:"8px 10px" }}/>
                  </div>

                  {/* Pay max */}
                  <div>
                    <label style={{ fontSize:10, color:B.muted, display:"block", marginBottom:5, fontWeight:700, letterSpacing:0.5 }}>💰 MAX PAY (₹/mo)</label>
                    <input type="number" placeholder="e.g. 40000" value={filters.payMax} onChange={e=>setF("payMax",e.target.value)}
                      style={{ ...inp, fontSize:12, padding:"8px 10px" }}/>
                  </div>

                  {/* Availability */}
                  <div>
                    <label style={{ fontSize:10, color:B.muted, display:"block", marginBottom:5, fontWeight:700, letterSpacing:0.5 }}>📅 JOINING AVAILABILITY</label>
                    <select value={filters.available} onChange={e=>setF("available",e.target.value)} style={{ ...inp, fontSize:12, padding:"8px 10px" }}>
                      {ALL_AVAIL.map(a=><option key={a} value={a} style={{ background:"#0d1b2a" }}>{a==="All"?"Any Availability":a}</option>)}
                    </select>
                  </div>
                </div>

                {/* Accommodation */}
                <div style={{ marginBottom:14 }}>
                  <label style={{ fontSize:10, color:B.muted, display:"block", marginBottom:7, fontWeight:700, letterSpacing:0.5 }}>🏠 ACCOMMODATION / STAY</label>
                  <div style={{ display:"flex", gap:8 }}>
                    {ALL_ACCOMM.map(a=>(
                      <button key={a} onClick={()=>setF("accommodation",a)} style={{ padding:"6px 14px", borderRadius:8, fontSize:12, border:"none", cursor:"pointer", fontFamily:"inherit",
                        background:filters.accommodation===a?B.nurse:"rgba(255,255,255,0.06)", color:filters.accommodation===a?"#030B14":B.muted, fontWeight:filters.accommodation===a?700:400 }}>
                        {a==="All"?"Any":a==="Available"?"✅ Stay Provided":"❌ Not Provided"}
                      </button>
                    ))}
                  </div>
                </div>

                {/* Skills */}
                <div style={{ marginBottom:14 }}>
                  <label style={{ fontSize:10, color:B.muted, display:"block", marginBottom:7, fontWeight:700, letterSpacing:0.5 }}>🎯 SKILLS REQUIRED (select to filter)</label>
                  <div style={{ display:"flex", gap:6, flexWrap:"wrap" }}>
                    {ALL_SKILLS.map(sk=>{
                      const sel = filters.skills.includes(sk);
                      return(
                        <button key={sk} onClick={()=>toggleSkill(sk)} style={{ padding:"4px 11px", borderRadius:20, fontSize:11, border:"none", cursor:"pointer", fontFamily:"inherit",
                          background:sel?B.primary:"rgba(255,255,255,0.05)", color:sel?"#030B14":B.muted, fontWeight:sel?700:400 }}>{sk}</button>
                      );
                    })}
                  </div>
                </div>

                {/* Reset */}
                <button onClick={()=>setFilters({search:"",city:"All",category:"All",role:"All",payMin:"",payMax:"",shift:"All",available:"All",accommodation:"All",skills:[],showFilters:true})}
                  style={{ ...btn(B.muted,true), fontSize:11, padding:"7px 16px" }}>↺ Reset All Filters</button>
              </div>
            )}

            {/* Results count */}
            <div style={{ fontSize:12, color:B.muted, marginBottom:12 }}>
              {visible.length===0 ? "No jobs match your filters." : `Showing ${visible.length} of ${JOBS_LIST.length} jobs`}
              {activeFilterCount>0 && <button onClick={()=>setFilters(f=>({...f,city:"All",category:"All",role:"All",payMin:"",payMax:"",shift:"All",available:"All",accommodation:"All",skills:[]}))} style={{ background:"none",border:"none",color:B.danger,cursor:"pointer",fontSize:11,marginLeft:10,fontFamily:"inherit" }}>✕ Clear filters</button>}
            </div>

            {/* Job cards */}
            <div style={{ display:"flex", flexDirection:"column", gap:12 }}>
              {visible.map(j=>(
                <div key={j.id} style={{ ...card(j.urgent?`rgba(${rgb(B.danger)},0.15)`:B.border), transition:"all 0.2s" }}>
                  {/* Top row */}
                  <div style={{ display:"flex", justifyContent:"space-between", alignItems:"flex-start", marginBottom:10, gap:10, flexWrap:"wrap" }}>
                    <div style={{ display:"flex", gap:11, alignItems:"flex-start" }}>
                      <div style={{ width:42,height:42,borderRadius:11,background:`rgba(${rgb(B.nurse)},0.15)`,display:"flex",alignItems:"center",justifyContent:"center",fontSize:20,flexShrink:0 }}>
                        {j.category==="Nurse"?"👩‍⚕️":j.category==="Helper"?"🧹":j.category==="Receptionist"?"🖥️":j.category==="Accountant"?"📊":j.category==="Lab Tech"?"🔬":"🚑"}
                      </div>
                      <div>
                        <div style={{ display:"flex", alignItems:"center", gap:7, flexWrap:"wrap" }}>
                          <span style={{ fontSize:15, fontWeight:800 }}>{j.role}</span>
                          {j.urgent && <span style={{ ...bdge(B.danger), fontSize:10 }}>🔴 Urgent</span>}
                        </div>
                        <div style={{ fontSize:12, color:B.muted, marginTop:2 }}>{j.clinic}</div>
                        <div style={{ fontSize:11, color:B.muted }}>📍 {j.city} · {j.slots} opening{j.slots>1?"s":""}</div>
                      </div>
                    </div>
                    <div style={{ textAlign:"right", flexShrink:0 }}>
                      <div style={{ fontSize:16, fontWeight:900, color:B.nurse }}>₹{j.payMin.toLocaleString("en-IN")}–{j.payMax.toLocaleString("en-IN")}</div>
                      <div style={{ fontSize:10, color:B.muted }}>per month</div>
                    </div>
                  </div>

                  {/* Meta chips */}
                  <div style={{ display:"flex", gap:7, flexWrap:"wrap", marginBottom:10 }}>
                    <span style={{ ...bdge(B.primary), fontSize:10 }}>⏰ {j.dutyHrs}</span>
                    <span style={{ ...bdge("#8B5CF6"), fontSize:10 }}>🌅 {j.shift}</span>
                    <span style={{ ...bdge(j.accommodation==="Available"?B.accent:B.muted), fontSize:10 }}>
                      🏠 Stay {j.accommodation}
                    </span>
                    <span style={{ ...bdge(j.available==="Immediate"?B.danger:B.warn), fontSize:10 }}>
                      📅 Join: {j.available}
                    </span>
                  </div>

                  {/* Skills */}
                  <div style={{ display:"flex", gap:5, flexWrap:"wrap", marginBottom:10 }}>
                    {j.skills.map(sk=>(
                      <span key={sk} style={{ background:"rgba(255,255,255,0.06)", border:`1px solid ${B.border}`, borderRadius:6, padding:"2px 8px", fontSize:10, color:B.muted }}>{sk}</span>
                    ))}
                  </div>

                  {/* Description */}
                  <div style={{ fontSize:12, color:"#94A3B8", lineHeight:1.6, marginBottom:12 }}>{j.desc}</div>

                  {/* Apply button */}
                  <div style={{ display:"flex", justifyContent:"flex-end" }}>
                    <button disabled={applied.includes(j.id)} onClick={()=>{setApplyJob(j);setAStep(0);setADone(false);}}
                      style={{ ...btn(applied.includes(j.id)?B.muted:B.nurse), padding:"8px 22px", fontSize:13, opacity:applied.includes(j.id)?0.5:1 }}>
                      {applied.includes(j.id)?"✓ Applied":"Apply Now →"}
                    </button>
                  </div>
                </div>
              ))}
              {visible.length===0 && (
                <div style={{ ...card(), textAlign:"center", padding:40, color:B.muted }}>
                  <div style={{ fontSize:36, marginBottom:10 }}>🔍</div>
                  <div style={{ fontSize:14 }}>No jobs match your current filters.</div>
                  <button onClick={()=>setFilters(f=>({...f,city:"All",category:"All",role:"All",payMin:"",payMax:"",shift:"All",available:"All",accommodation:"All",skills:[]}))}
                    style={{ ...btn(B.nurse), marginTop:14, fontSize:12 }}>Clear Filters</button>
                </div>
              )}
            </div>
          </div>
        )}

        {/* APPLY FLOW */}
        {tab==="jobs" && applyJob && (
          <div style={{ maxWidth:500 }}>
            <button onClick={()=>setApplyJob(null)} style={{ background:"none",border:"none",color:B.nurse,cursor:"pointer",fontSize:13,marginBottom:18,padding:0,fontFamily:"inherit" }}>← Back</button>
            {aDone ? (
              <div style={{ textAlign:"center", padding:"40px 20px" }}>
                <div style={{ fontSize:56, marginBottom:12 }}>🎉</div>
                <h2 style={{ fontSize:20, color:B.accent }}>Application Sent!</h2>
                <p style={{ color:B.muted, fontSize:13, marginTop:8 }}>The clinic will contact you on WhatsApp within 48 hrs.</p>
                <button onClick={()=>{setApplyJob(null);setADone(false);}} style={{ ...btn(B.nurse), marginTop:20 }}>Browse More Jobs</button>
              </div>
            ) : (
              <>
                <div style={{ ...card(`rgba(${rgb(B.nurse)},0.18)`), marginBottom:18, display:"flex", gap:12, alignItems:"center" }}>
                  <div style={{ fontSize:28 }}>👩‍⚕️</div>
                  <div><div style={{ fontSize:15, fontWeight:700 }}>{applyJob.role}</div><div style={{ fontSize:12, color:B.muted }}>{applyJob.clinic} · {applyJob.city}</div><div style={{ fontSize:13, fontWeight:700, color:B.nurse, marginTop:2 }}>₹{applyJob.payMin?.toLocaleString("en-IN")}–{applyJob.payMax?.toLocaleString("en-IN")}/mo</div></div>
                </div>
                {/* Steps */}
                <div style={{ display:"flex", alignItems:"center", marginBottom:22, gap:0 }}>
                  {["Cities","Cover","Review"].map((s,i)=>(
                    <div key={s} style={{ display:"flex", alignItems:"center", flex:i<2?1:"none" }}>
                      <div style={{ textAlign:"center" }}>
                        <div style={{ width:26,height:26,borderRadius:"50%",display:"flex",alignItems:"center",justifyContent:"center",fontSize:11,fontWeight:700,background:i<aStep?B.accent:i===aStep?B.nurse:"rgba(255,255,255,0.08)",color:i<=aStep?"#030B14":B.muted }}>{i<aStep?"✓":i+1}</div>
                        <div style={{ fontSize:9,color:i===aStep?B.nurse:B.muted,marginTop:2 }}>{s}</div>
                      </div>
                      {i<2&&<div style={{ flex:1,height:1,background:B.border,margin:"0 6px 14px" }}/>}
                    </div>
                  ))}
                </div>
                {aStep===0 && (
                  <div>
                    <label style={{ fontSize:11, color:B.muted, display:"block", marginBottom:8 }}>Cities you can work in</label>
                    <div style={{ display:"flex", flexWrap:"wrap", gap:6, marginBottom:14 }}>
                      {CITIES.map(c=>{const s=aForm.cities.includes(c);return(<button key={c} onClick={()=>setAForm({...aForm,cities:s?aForm.cities.filter(x=>x!==c):[...aForm.cities,c]})} style={{ padding:"5px 12px",borderRadius:20,fontSize:11,cursor:"pointer",border:"none",fontFamily:"inherit",background:s?B.nurse:"rgba(255,255,255,0.06)",color:s?"#030B14":B.muted,fontWeight:s?700:400 }}>{c}</button>);})}
                    </div>
                    <label style={{ fontSize:11, color:B.muted, display:"block", marginBottom:7 }}>Preferred Shift</label>
                    <div style={{ display:"flex", gap:7, flexWrap:"wrap", marginBottom:14 }}>
                      {["Morning","Evening","Night","Flexible"].map(s=><button key={s} onClick={()=>setAForm({...aForm,shift:s})} style={{ padding:"7px 13px",borderRadius:8,fontSize:12,cursor:"pointer",fontFamily:"inherit",background:aForm.shift===s?B.nurse:"rgba(255,255,255,0.05)",color:aForm.shift===s?"#030B14":B.text,border:`1px solid ${aForm.shift===s?B.nurse:B.border}`,fontWeight:aForm.shift===s?700:400 }}>{s}</button>)}
                    </div>
                    <div style={{ marginBottom:16 }}>
                      <label style={{ fontSize:11, color:B.muted, display:"block", marginBottom:5 }}>Start Date</label>
                      <input type="date" value={aForm.start} onChange={e=>setAForm({...aForm,start:e.target.value})} style={inp}/>
                    </div>
                    <button disabled={!aForm.cities.length||!aForm.shift} onClick={()=>setAStep(1)} style={{ ...btn(B.nurse), opacity:(!aForm.cities.length||!aForm.shift)?0.4:1 }}>Continue →</button>
                  </div>
                )}
                {aStep===1 && (
                  <div>
                    <label style={{ fontSize:11, color:B.muted, display:"block", marginBottom:6 }}>Cover Note (optional)</label>
                    <textarea rows={5} value={aForm.cover} onChange={e=>setAForm({...aForm,cover:e.target.value})} placeholder="Describe your experience and why you're interested…" style={{ ...inp, resize:"vertical", marginBottom:16 }}/>
                    <div style={{ display:"flex", gap:9 }}>
                      <button onClick={()=>setAStep(0)} style={btn(B.muted,true)}>← Back</button>
                      <button onClick={()=>setAStep(2)} style={btn(B.nurse)}>Continue →</button>
                    </div>
                  </div>
                )}
                {aStep===2 && (
                  <div>
                    <div style={{ ...card(), marginBottom:16 }}>
                      {[["Role",applyJob.role],["Clinic",applyJob.clinic],["City",applyJob.city],["Your Cities",aForm.cities.join(", ")||"—"],["Shift",aForm.shift||"—"],["Start",aForm.start||"—"]].map(([k,v])=>(
                        <div key={k} style={{ display:"flex", justifyContent:"space-between", padding:"9px 0", borderBottom:`1px solid ${B.border}`, fontSize:13 }}>
                          <span style={{ color:B.muted }}>{k}</span><span style={{ fontWeight:600 }}>{v}</span>
                        </div>
                      ))}
                    </div>
                    <div style={{ display:"flex", gap:9 }}>
                      <button onClick={()=>setAStep(1)} style={btn(B.muted,true)}>← Back</button>
                      <button onClick={submitApp} style={btn(B.nurse)}>✓ Submit Application</button>
                    </div>
                  </div>
                )}
              </>
            )}
          </div>
        )}

        {/* APPLIED */}
        {tab==="applied" && (
          <div>
            <h2 style={{ fontSize:20, fontWeight:800, marginBottom:16 }}>My Applications</h2>
            {myApps.length===0 ? (
              <div style={{ ...card(), textAlign:"center", color:B.muted, padding:40 }}>
                <div style={{ fontSize:36, marginBottom:10 }}>📋</div>
                <div>No applications yet.</div>
                <button onClick={()=>setTab("jobs")} style={{ ...btn(B.nurse), marginTop:14 }}>Browse Jobs →</button>
              </div>
            ) : myApps.map(a=>(
              <div key={a.id} style={{ ...card(`rgba(${rgb(B.accent)},0.15)`), marginBottom:11 }}>
                <div style={{ display:"flex", justifyContent:"space-between", alignItems:"flex-start" }}>
                  <div>
                    <div style={{ fontSize:14, fontWeight:700 }}>{a.role}</div>
                    <div style={{ fontSize:12, color:B.muted }}>{a.clinic} · {a.city}</div>
                    <div style={{ fontSize:13, color:B.nurse, fontWeight:700, marginTop:3 }}>₹{a.pay||`${(a.payMin||"")?.toLocaleString?.("en-IN")||"—"}`}/mo</div>
                  </div>
                  <Pill label={a.status} color={{ Pending:B.warn,Shortlisted:B.primary,Hired:B.accent,Rejected:B.danger }[a.status]}/>
                </div>
                <button onClick={()=>{setChatApp(a);setTab("messages");}} style={{ ...btn(B.nurse,true), marginTop:12, fontSize:12, padding:"7px 14px" }}>
                  💬 Open Chat {a.unread>0&&<span style={{ background:B.danger,color:"#FFF",borderRadius:"50%",padding:"1px 5px",fontSize:9,marginLeft:4 }}>{a.unread}</span>}
                </button>
              </div>
            ))}
          </div>
        )}

        {/* MESSAGES */}
        {tab==="messages" && (
          <div>
            <h2 style={{ fontSize:20, fontWeight:800, marginBottom:16 }}>Messages</h2>
            {chatApp ? (
              <ChatWindow app={chatApp} senderRole="nurse" onClose={()=>setChatApp(null)} onSend={sendMsg} isMobile={isMobile}/>
            ) : (
              <div style={{ display:"flex", flexDirection:"column", gap:10 }}>
                {myApps.length===0 && <div style={{ ...card(), textAlign:"center", color:B.muted, padding:40 }}>No messages yet. Apply for a job to start chatting with clinics.</div>}
                {myApps.map(a=>(
                  <div key={a.id} onClick={()=>setChatApp(a)} style={{ ...card(a.unread>0?`rgba(${rgb(B.nurse)},0.3)`:B.border), cursor:"pointer", display:"flex", justifyContent:"space-between", alignItems:"center" }}>
                    <div style={{ display:"flex", gap:11, alignItems:"center" }}>
                      <div style={{ width:38,height:38,borderRadius:"50%",background:`rgba(${rgb(B.primary)},0.15)`,display:"flex",alignItems:"center",justifyContent:"center",fontSize:18 }}>🏥</div>
                      <div>
                        <div style={{ fontSize:13, fontWeight:700 }}>{a.clinic}</div>
                        <div style={{ fontSize:11, color:B.muted }}>{a.role} · {a.msgs[a.msgs.length-1]?.text?.slice(0,40)}…</div>
                      </div>
                    </div>
                    <div style={{ textAlign:"right" }}>
                      {a.unread>0 && <span style={{ background:B.danger,color:"#FFF",borderRadius:"50%",padding:"2px 7px",fontSize:11,fontWeight:700 }}>{a.unread}</span>}
                      <div style={{ fontSize:10, color:B.muted, marginTop:4 }}>{a.msgs[a.msgs.length-1]?.time}</div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        {/* PROFILE */}
        {tab==="profile" && (
          <div style={{ maxWidth:440 }}>
            <h2 style={{ fontSize:20, fontWeight:800, marginBottom:18 }}>My Profile</h2>
            <div style={{ ...card(`rgba(${rgb(B.nurse)},0.18)`), marginBottom:16, display:"flex", gap:14, alignItems:"center" }}>
              <div style={{ width:52,height:52,borderRadius:"50%",background:`linear-gradient(135deg,${B.nurse},#F472B6)`,display:"flex",alignItems:"center",justifyContent:"center",fontSize:24 }}>👩‍⚕️</div>
              <div><div style={{ fontSize:17, fontWeight:700 }}>{user.name}</div><div style={{ fontSize:12, color:B.muted }}>{user.roleType||"Nursing Staff"} · {user.city}</div><Pill label="Profile Active" color={B.accent}/></div>
            </div>
            {[["Name",user.name||"—"],["Phone",user.phone||"—"],["City",user.city||"—"],["Role",user.roleType||"—"],["Applied Jobs",applied.length]].map(([k,v])=>(
              <div key={k} style={{ display:"flex", justifyContent:"space-between", padding:"11px 0", borderBottom:`1px solid ${B.border}`, fontSize:13 }}>
                <span style={{ color:B.muted }}>{k}</span><span style={{ fontWeight:600 }}>{v}</span>
              </div>
            ))}
          </div>
        )}
      </div>

      {/* Mobile bottom nav */}
      {isMobile && (
        <div style={{ position:"fixed", bottom:0, left:0, right:0, background:"rgba(3,11,20,0.97)", borderTop:`1px solid ${B.border}`, zIndex:100, display:"flex", padding:"8px 0 12px" }}>
          {NAV.map(n=>(
            <button key={n.id} onClick={()=>setTab(n.id)} style={{ flex:1, background:"none", border:"none", cursor:"pointer", display:"flex", flexDirection:"column", alignItems:"center", gap:2, fontFamily:"inherit", position:"relative" }}>
              <span style={{ fontSize:18 }}>{n.icon}</span>
              <span style={{ fontSize:9, color:tab===n.id?B.nurse:B.muted, fontWeight:tab===n.id?700:400 }}>{n.label}</span>
              {n.id==="messages"&&unreadTotal>0&&<span style={{ position:"absolute",top:0,right:"20%",background:B.danger,color:"#FFF",borderRadius:"50%",width:14,height:14,display:"flex",alignItems:"center",justifyContent:"center",fontSize:8,fontWeight:700 }}>{unreadTotal}</span>}
            </button>
          ))}
        </div>
      )}
    </div>
  );
}


