    { id:"location",   icon:"📍", title:"Location Finder",      color:"#06B6D4", desc:"Data-driven analysis of ideal clinic catchment areas",   category:"Operations" },
    // Equipment
    { id:"equipment",  icon:"🔬", title:"Buy Equipment",        color:"#F59E0B", desc:"New & certified secondhand diagnostic & surgical gear",  category:"Equipment"  },
    { id:"furniture",  icon:"🪑", title:"Clinic Furniture",     color:"#F97316", desc:"Exam tables, waiting room sets, storage & reception",    category:"Equipment"  },
    { id:"pharmastock",icon:"💊", title:"Pharmacy Stock",       color:"#EC4899", desc:"Wholesale medicines, consumables & surgical supplies",   category:"Equipment"  },
    // Digital & Marketing
    { id:"social",     icon:"📱", title:"Social Media Mgmt",   color:"#EC4899", desc:"Content, posting, Google reviews & reputation building", category:"Digital"    },
    { id:"website",    icon:"🌐", title:"Clinic Website",       color:"#06B6D4", desc:"Professional website with appointment booking & SEO",    category:"Digital"    },
    { id:"whatsapp",   icon:"💬", title:"WhatsApp Marketing",   color:"#10B981", desc:"Broadcast messages, appointment reminders & follow-ups", category:"Digital"    },
    { id:"branding",   icon:"🎨", title:"Clinic Branding",      color:"#A855F7", desc:"Logo, signage, visiting cards & patient-facing design",  category:"Digital"    },
    // Software (links to software tab)
    { id:"emr_s",      icon:"🗂️", title:"EMR / EHR Software",  color:"#0EA5E9", desc:"Digital prescriptions, patient records & ABDM-ready",   category:"Software",  goSoftware:true },
    { id:"billing_s",  icon:"🧾", title:"Billing & GST",        color:"#10B981", desc:"Automated invoicing, GST filing & insurance claims",     category:"Software",  goSoftware:true },
    { id:"appt_s",     icon:"📅", title:"Appointment System",   color:"#8B5CF6", desc:"Online booking, queue management & WhatsApp alerts",    category:"Software",  goSoftware:true },
    { id:"tele_s",     icon:"📹", title:"Teleconsultation",     color:"#F59E0B", desc:"HD video OPD, e-prescriptions & payment collection",    category:"Software",  goSoftware:true },
    { id:"abdm_s",     icon:"🏛️", title:"Ayushman Bharat",      color:"#EC4899", desc:"AB-PMJAY claim submission, pre-auth & rejection tracking",category:"Software", goSoftware:true },
    { id:"pharma_s",   icon:"💊", title:"Pharmacy Software",    color:"#F97316", desc:"Inventory, expiry alerts, barcode billing & reorders",   category:"Software",  goSoftware:true },
    { id:"lab_s",      icon:"🔬", title:"Lab / LIMS Software",  color:"#06B6D4", desc:"Test catalogue, auto PDF reports & NABL compliance",    category:"Software",  goSoftware:true },
    // Compliance & Legal
    { id:"nabh",       icon:"📜", title:"NABH Accreditation",   color:"#F59E0B", desc:"Full NABH documentation, audit prep & certification",   category:"Compliance" },
    { id:"druglicense",icon:"⚕️", title:"Drug License",         color:"#10B981", desc:"New drug license, renewal & regulatory guidance",       category:"Compliance" },
    { id:"gst",        icon:"🔏", title:"GST Registration",     color:"#0EA5E9", desc:"GST registration, quarterly filing & audit support",    category:"Compliance" },
    { id:"legal",      icon:"⚖️", title:"Legal & Contracts",    color:"#A855F7", desc:"Doctor employment contracts, rent deeds & NDAs",        category:"Compliance" },
  ];

  const SERVICE_CATS = ["All","Operations","Equipment","Digital","Software","Compliance"];

  const NAV = [
    { id:"services", icon:"🏥", label:"Services"   },
    { id:"software", icon:"💻", label:"Software"   },
    { id:"ai",       icon:"🤖", label:"AI Advisor" },
    { id:"requests", icon:"📋", label:"Requests"   },
  ];

  const TAG_FILTERS = ["All","ABDM Ready","GST Filing","Cloud-based","WhatsApp alerts","NHA Approved"];
  const visible = SOFTWARE_SOLUTIONS.filter(s => catFilter==="All" || s.tags.some(t=>t===catFilter));

  function requestDemo(sol) {
    if (requested.includes(sol.id)) return;
    setRequested([...requested, sol.id]);
    setShowDemoToast(sol);
    setTimeout(()=>setShowDemoToast(null), 4000);
  }

  function openDetail(sol) { setSelected(sol); setDetailTab("overview"); }

  return (
    <div style={{ minHeight:"100vh", background:B.bg, display:"flex", fontFamily:"'Palatino Linotype',Georgia,serif", color:B.text }}>

      {/* Desktop sidebar */}
      {!isMobile && (
        <div style={{ width:210, minHeight:"100vh", background:"rgba(255,255,255,0.025)", borderRight:`1px solid ${B.border}`, display:"flex", flexDirection:"column", position:"sticky", top:0, flexShrink:0 }}>
          <div style={{ padding:"18px 18px 14px", borderBottom:`1px solid ${B.border}`, marginBottom:8 }}>
            <div style={{ display:"flex", alignItems:"center", gap:9 }}><Logo size={28}/>
              <div style={{ fontSize:14, fontWeight:800, background:`linear-gradient(135deg,${B.primary},${B.accent})`, WebkitBackgroundClip:"text", WebkitTextFillColor:"transparent" }}>Corvallis</div>
            </div>
            <div style={{ fontSize:10, color:B.muted, marginTop:4, fontStyle:"italic" }}>The connective tissue of Indian healthcare.</div>
          </div>
          {NAV.map(n => (
            <button key={n.id} onClick={()=>{ setTab(n.id); setSelected(null); }} style={{ display:"flex", alignItems:"center", gap:10, padding:"10px 18px", cursor:"pointer", fontSize:13, fontWeight:tab===n.id?700:400, color:tab===n.id?B.primary:B.muted, background:tab===n.id?`rgba(${rgb(B.primary)},0.09)`:"none", borderLeft:tab===n.id?`3px solid ${B.primary}`:"3px solid transparent", border:"none", width:"100%", textAlign:"left", fontFamily:"inherit" }}>
              <span>{n.icon}</span>{n.label}
              {n.id==="ai" && <span style={{ marginLeft:"auto", ...bdge("#A855F7"), fontSize:9, padding:"2px 6px" }}>AI</span>}
            </button>
          ))}
          <div style={{ flex:1 }}/>
          <div style={{ display:"flex", height:3, margin:"0 0 12px" }}>
            <div style={{ flex:1, background:"#FF9933" }}/><div style={{ flex:1, background:"rgba(255,255,255,0.15)" }}/><div style={{ flex:1, background:"#138808" }}/>
          </div>
          <div style={{ padding:"0 18px" }}>
            <div style={{ fontSize:12, fontWeight:700 }}>Dr. {user.name}</div>
            <div style={{ fontSize:10, color:B.muted, marginBottom:10 }}>NMC Verified · {user.city}</div>
            <button onClick={onLogout} style={{ ...btn(B.muted,true), width:"100%", padding:"7px", fontSize:11 }}>Sign Out</button>
          </div>
        </div>
      )}

      {/* Page content */}
      <div style={{ flex:1, padding:isMobile?"14px 14px 80px":"20px 26px", overflowX:"hidden", position:"relative" }}>

        {/* Mobile header */}
        {isMobile && (
          <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:16 }}>
            <div style={{ display:"flex", alignItems:"center", gap:8 }}><Logo size={26}/><span style={{ fontSize:14, fontWeight:800 }}>Corvallis</span></div>
            <button onClick={onLogout} style={{ ...btn(B.muted,true), padding:"6px 10px", fontSize:11 }}>Out</button>
          </div>
        )}

        {/* Demo toast */}
        {showDemoToast && (
          <div style={{ position:"fixed", bottom:isMobile?80:24, right:16, zIndex:200, ...card(`rgba(${rgb(B.accent)},0.4)`), padding:"13px 18px", maxWidth:320, boxShadow:"0 8px 32px rgba(0,0,0,0.4)" }}>
            <div style={{ fontSize:13, fontWeight:700, color:B.accent }}>✅ Demo Requested!</div>
            <div style={{ fontSize:11, color:B.muted, marginTop:3 }}>We'll call you within 24 hrs for <strong style={{ color:"#FFF" }}>{showDemoToast.title}</strong></div>
          </div>
        )}

        {/* ── SOFTWARE TAB ── */}
        {tab==="software" && !selected && (
          <div>
            <div style={{ marginBottom:18 }}>
              <div style={{ fontSize:10, letterSpacing:4, color:B.primary, textTransform:"uppercase", marginBottom:4 }}>Clinic Technology</div>
              <h2 style={{ fontSize:22, fontWeight:800, margin:0 }}>Software Solutions</h2>
              <p style={{ color:B.muted, fontSize:13, margin:"5px 0 0" }}>Browse, compare & get AI-powered recommendations</p>
            </div>

            {/* AI nudge banner */}
            <div style={{ ...card(`rgba(${rgb("#A855F7")},0.15)`), marginBottom:18, display:"flex", gap:12, alignItems:"center", flexWrap:"wrap", cursor:"pointer" }} onClick={()=>setTab("ai")}>
              <div style={{ fontSize:28 }}>🤖</div>
              <div style={{ flex:1 }}>
                <div style={{ fontSize:13, fontWeight:700, color:"#A855F7" }}>Not sure what software you need?</div>
                <div style={{ fontSize:12, color:B.muted, marginTop:2 }}>Our AI Advisor analyses your specialty & clinic size and recommends the perfect stack — with exact pricing.</div>
              </div>
              <button style={{ ...btn("#A855F7"), fontSize:12, padding:"8px 16px" }}>Ask AI →</button>
            </div>

            <div style={{ display:"flex", gap:7, flexWrap:"wrap", marginBottom:18 }}>
              {TAG_FILTERS.map(f => (
                <button key={f} onClick={()=>setCatFilter(f)} style={{ padding:"5px 13px", borderRadius:20, fontSize:11, fontWeight:600, border:"none", cursor:"pointer", fontFamily:"inherit",
                  background: catFilter===f?B.primary:"rgba(255,255,255,0.06)", color:catFilter===f?"#030B14":B.muted }}>{f}</button>
              ))}
            </div>

            <div style={{ display:"grid", gridTemplateColumns:`repeat(auto-fill,minmax(${isMobile?"100%":"265px"},1fr))`, gap:13 }}>
              {visible.map(s => (
                <div key={s.id} style={{ ...card(`rgba(${rgb(s.color)},0.1)`), transition:"all 0.2s", position:"relative", cursor:"pointer" }}
                  onClick={()=>openDetail(s)}
                  onMouseEnter={e=>{ e.currentTarget.style.borderColor=s.color; e.currentTarget.style.transform="translateY(-3px)"; }}
                  onMouseLeave={e=>{ e.currentTarget.style.borderColor=`rgba(${rgb(s.color)},0.1)`; e.currentTarget.style.transform="translateY(0)"; }}>

                  {requested.includes(s.id) && <span style={{ ...bdge(B.accent), position:"absolute", top:10, right:10, fontSize:10 }}>✓ Requested</span>}

                  <div style={{ display:"flex", gap:11, alignItems:"center", marginBottom:10 }}>
                    <div style={{ width:42,height:42,borderRadius:11,background:`rgba(${rgb(s.color)},0.18)`,display:"flex",alignItems:"center",justifyContent:"center",fontSize:20,flexShrink:0 }}>{s.icon}</div>
                    <div>
                      <div style={{ fontSize:14, fontWeight:700 }}>{s.title}</div>
                      <div style={{ fontSize:11, color:B.muted, marginTop:1 }}>{s.tagline}</div>
                    </div>
                  </div>

                  {/* Avg rating */}
                  <div style={{ marginBottom:8 }}>
                    <Stars rating={parseFloat((s.vendors.reduce((a,v)=>a+v.rating,0)/s.vendors.length).toFixed(1))} color={s.color}/>
                    <span style={{ fontSize:11, color:B.muted, marginLeft:6 }}>{s.reviews.length} reviews</span>
                  </div>

                  <div style={{ display:"flex", gap:5, flexWrap:"wrap", marginBottom:12 }}>
                    {s.tags.slice(0,2).map(t=><span key={t} style={{ ...bdge(s.color), fontSize:10 }}>{t}</span>)}
                  </div>

                  <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center" }}>
                    <div style={{ fontSize:13, fontWeight:800, color:s.color }}>{s.price}</div>
                    <div style={{ display:"flex", gap:6 }}>
                      <button onClick={e=>{e.stopPropagation();requestDemo(s);}} disabled={requested.includes(s.id)}
                        style={{ ...btn(s.color,true), padding:"6px 11px", fontSize:11, opacity:requested.includes(s.id)?0.4:1 }}>
                        {requested.includes(s.id)?"Requested":"Demo"}
                      </button>
                      <button onClick={e=>{e.stopPropagation();openDetail(s);}} style={{ ...btn(s.color), padding:"6px 11px", fontSize:11 }}>View →</button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* ── SOFTWARE DETAIL VIEW ── */}
        {tab==="software" && selected && (
          <div>
            <button onClick={()=>setSelected(null)} style={{ background:"none", border:"none", color:B.primary, cursor:"pointer", fontSize:13, marginBottom:18, padding:0, fontFamily:"inherit" }}>← All Software</button>

            {/* Header */}
            <div style={{ display:"flex", gap:14, alignItems:"flex-start", marginBottom:18, flexWrap:"wrap" }}>
              <div style={{ width:52,height:52,borderRadius:14,background:`rgba(${rgb(selected.color)},0.2)`,display:"flex",alignItems:"center",justifyContent:"center",fontSize:26,flexShrink:0 }}>{selected.icon}</div>
              <div style={{ flex:1 }}>
                <div style={{ fontSize:22, fontWeight:800 }}>{selected.title}</div>
                <div style={{ fontSize:13, color:B.muted, marginTop:3 }}>{selected.tagline}</div>
                <div style={{ display:"flex", gap:6, flexWrap:"wrap", marginTop:7 }}>
                  {selected.tags.map(t=><span key={t} style={bdge(selected.color)}>{t}</span>)}
                </div>
              </div>
              <div style={{ textAlign:"right" }}>
                <div style={{ fontSize:18, fontWeight:800, color:selected.color }}>{selected.price}</div>
                <Stars rating={parseFloat((selected.vendors.reduce((a,v)=>a+v.rating,0)/selected.vendors.length).toFixed(1))} color={selected.color}/>
                <button onClick={()=>requestDemo(selected)} disabled={requested.includes(selected.id)}
                  style={{ ...btn(selected.color), marginTop:10, fontSize:12, padding:"8px 18px", opacity:requested.includes(selected.id)?0.5:1, display:"block" }}>
                  {requested.includes(selected.id)?"✓ Requested":"🎬 Free Demo"}
                </button>
              </div>
            </div>

            {/* Sub-tabs */}
            <div style={{ display:"flex", background:"rgba(255,255,255,0.04)", borderRadius:12, padding:4, marginBottom:22, width:"fit-content", gap:2 }}>
              {[["overview","📋 Overview"],["pricing","💰 Pricing Table"],["reviews","⭐ Reviews"]].map(([id,label])=>(
                <button key={id} onClick={()=>setDetailTab(id)} style={{ padding:"9px 18px", borderRadius:9, border:"none", cursor:"pointer", fontSize:12, fontWeight:700, fontFamily:"inherit",
                  background:detailTab===id?selected.color:"transparent", color:detailTab===id?"#030B14":B.muted, transition:"all 0.18s" }}>{label}</button>
              ))}
            </div>

            {/* Overview */}
            {detailTab==="overview" && (
              <div>
                <div style={{ marginBottom:18 }}>
                  <div style={{ fontSize:11, color:B.muted, fontWeight:700, letterSpacing:1, textTransform:"uppercase", marginBottom:10 }}>Key Features</div>
                  <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fill,minmax(180px,1fr))", gap:8 }}>
                    {selected.features.map(f=>(
                      <div key={f} style={{ ...card(), padding:"10px 14px", fontSize:12, display:"flex", gap:8, alignItems:"center" }}>
                        <span style={{ color:selected.color }}>✓</span>{f}
                      </div>
                    ))}
                  </div>
                </div>
                <div style={{ marginBottom:18 }}>
                  <div style={{ fontSize:11, color:B.muted, fontWeight:700, letterSpacing:1, textTransform:"uppercase", marginBottom:10 }}>Best For</div>
                  <div style={{ display:"flex", gap:7, flexWrap:"wrap" }}>
                    {selected.specialties.map(s=><span key={s} style={{ ...bdge(selected.color) }}>{s}</span>)}
                  </div>
                </div>
                <div>
                  <div style={{ fontSize:11, color:B.muted, fontWeight:700, letterSpacing:1, textTransform:"uppercase", marginBottom:10 }}>Available Vendors ({selected.vendors.length})</div>
                  <div style={{ display:"grid", gridTemplateColumns:`repeat(auto-fill,minmax(${isMobile?"140px":"180px"},1fr))`, gap:9 }}>
                    {selected.vendors.map(v=>(
                      <div key={v.name} style={{ ...card(), padding:"12px 14px" }}>
                        <div style={{ fontSize:13, fontWeight:700, marginBottom:4 }}>{v.name}</div>
                        <Stars rating={v.rating} color={selected.color}/>
                        <div style={{ fontSize:13, fontWeight:800, color:selected.color, marginTop:4 }}>{v.price}</div>
                        <div style={{ fontSize:10, color:B.muted }}>{v.users} users</div>
                        <div style={{ fontSize:10, color:selected.color, marginTop:4 }}>★ {v.highlight}</div>
                      </div>
                    ))}
                  </div>
                </div>
                <div style={{ display:"flex", gap:10, marginTop:20, flexWrap:"wrap" }}>
                  <button onClick={()=>setDetailTab("pricing")} style={btn(selected.color,true)}>💰 Compare Pricing →</button>
                  <button onClick={()=>setDetailTab("reviews")} style={btn(selected.color,true)}>⭐ Read Reviews →</button>
                </div>
              </div>
            )}

            {/* Pricing table */}
            {detailTab==="pricing" && (
              <div>
                <div style={{ fontSize:13, color:B.muted, marginBottom:16 }}>Side-by-side comparison of all {selected.title} vendors available in India</div>
                <PricingTable sol={selected} onDemo={requestDemo} requested={requested}/>
                <div style={{ ...card(`rgba(${rgb(selected.color)},0.1)`), padding:16 }}>
                  <div style={{ fontSize:12, fontWeight:700, color:selected.color, marginBottom:6 }}>💡 Corvallis Tip</div>
                  <div style={{ fontSize:12, color:B.muted, lineHeight:1.6 }}>
                    Most Indian clinics start with the mid-tier plan and upgrade within 6 months. All vendors above offer a free 14–30 day trial. Request a demo to get exclusive Corvallis pricing discounts.
                  </div>
                </div>
              </div>
            )}

            {/* Reviews */}
            {detailTab==="reviews" && <ReviewsSection sol={selected} isMobile={isMobile}/>}
          </div>
        )}

        {/* ── AI ADVISOR TAB ── */}
        {tab==="ai" && <AIRecommender user={user} onSelectSoftware={openDetail}/>}

        {/* ── SERVICES TAB ── */}
        {tab==="services" && (
          hiringOpen
            ? <StaffHiringPortal user={user} isMobile={isMobile} onBack={()=>setHiringOpen(false)}/>
            : clinicOpen
              ? <ClinicSpacePortal user={user} isMobile={isMobile} onBack={()=>setClinicOpen(false)}/>
              : <ServicesTabContent setTab={setTab} isMobile={isMobile} SERVICES_LIST={SERVICES_LIST} SERVICE_CATS={SERVICE_CATS} onHireStaff={()=>setHiringOpen(true)} onClinicSpace={()=>setClinicOpen(true)}/>
        )}

        {/* ── REQUESTS TAB ── */}
        {tab==="requests" && (
          <div>
            <h2 style={{ fontSize:20, fontWeight:800, marginBottom:16 }}>My Requests</h2>
            {requested.length > 0 && (
              <div style={{ marginBottom:20 }}>
                <div style={{ fontSize:11, color:B.muted, fontWeight:700, letterSpacing:1, textTransform:"uppercase", marginBottom:11 }}>💻 Software Demo Requests</div>
                {SOFTWARE_SOLUTIONS.filter(s=>requested.includes(s.id)).map(s=>(
                  <div key={s.id} style={{ ...card(`rgba(${rgb(s.color)},0.15)`), marginBottom:10, display:"flex", justifyContent:"space-between", alignItems:"center" }}>
                    <div style={{ display:"flex", gap:11, alignItems:"center" }}>
                      <div style={{ fontSize:22 }}>{s.icon}</div>
                      <div>
                        <div style={{ fontSize:14, fontWeight:600 }}>{s.title}</div>
                        <div style={{ fontSize:11, color:B.muted }}>Demo call within 24 hrs · {s.price}</div>
                      </div>
                    </div>
                    <Pill label="Demo Requested" color={s.color}/>
                  </div>
                ))}
              </div>
            )}
            <div style={{ fontSize:11, color:B.muted, fontWeight:700, letterSpacing:1, textTransform:"uppercase", marginBottom:11 }}>🏥 Service Requests</div>
            {[
              {id:1, s:"Hire Staff",   d:"Staff Nurse, Mumbai",          st:"In Progress", c:B.accent  },
              {id:2, s:"Clinic Space", d:"Koramangala, Bengaluru",        st:"Matched",     c:B.primary },
              {id:3, s:"Locum Doctor", d:"Mar 5–10, General Med, Delhi",  st:"Pending",     c:"#8B5CF6" },
            ].map(r=>(
              <div key={r.id} style={{ ...card(), marginBottom:11, display:"flex", justifyContent:"space-between", alignItems:"center" }}>
                <div style={{ display:"flex", gap:11, alignItems:"center" }}>
                  <div style={{ width:8, height:8, borderRadius:"50%", background:r.c }}/>
                  <div><div style={{ fontSize:14, fontWeight:600 }}>{r.s}</div><div style={{ fontSize:12, color:B.muted }}>{r.d}</div></div>
                </div>
                <Pill label={r.st} color={r.c}/>
              </div>
            ))}
          </div>
        )}
      </div>

      {/* Mobile bottom nav */}
      {isMobile && (
        <div style={{ position:"fixed", bottom:0, left:0, right:0, background:"rgba(3,11,20,0.97)", borderTop:`1px solid ${B.border}`, zIndex:100, display:"flex", padding:"8px 0 12px" }}>
          {NAV.map(n=>(
            <button key={n.id} onClick={()=>{ setTab(n.id); setSelected(null); }} style={{ flex:1, background:"none", border:"none", cursor:"pointer", display:"flex", flexDirection:"column", alignItems:"center", gap:2, fontFamily:"inherit" }}>
              <span style={{ fontSize:18 }}>{n.icon}</span>
              <span style={{ fontSize:9, color:tab===n.id?B.primary:B.muted, fontWeight:tab===n.id?700:400 }}>{n.label}</span>
            </button>
          ))}
        </div>
      )}
    </div>
  );
}
// ═══════════════════════════════════════════════════════════════════
// ── ROOT ───────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════
function App() {
  const [screen, setScreen] = useState("landing");
  const [user, setUser]     = useState(null);
  const [apps, setApps]     = useState(INIT_APPS);

  function login(u)  { setUser(u); setScreen(u.type+"-app"); }
  function logout()  { setUser(null); setScreen("landing"); }
  function goAuth(r) { setScreen(r+"-auth"); }

  return (
    <>
      {screen==="landing"   && <Landing   onSelect={goAuth} />}
      {screen==="doctor-auth" && <QuickAuth role="doctor" onLogin={login} onBack={()=>setScreen("landing")} />}
      {screen==="nurse-auth"  && <QuickAuth role="nurse"  onLogin={login} onBack={()=>setScreen("landing")} />}
      {screen==="admin-auth"  && <QuickAuth role="admin"  onLogin={login} onBack={()=>setScreen("landing")} />}
      {screen==="doctor-app"  && user && <DoctorPortal user={user} onLogout={logout} />}
      {screen==="nurse-app"   && user && <NursePortal  user={user} onLogout={logout} apps={apps} setApps={setApps} />}
      {screen==="admin-app"   && user && <AdminPanel   user={user} onLogout={logout} apps={apps} setApps={setApps} />}
    </>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<App />);
  </script>
</body>
</html>
