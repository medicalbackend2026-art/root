// ── Doctor reviews section ────────────────────────────────────────
function ReviewsSection({ sol, isMobile }) {
  const [newReview, setNewReview] = useState({ rating:5, text:"", vendor:sol.vendors[0].name });
  const [submitted, setSubmitted] = useState(false);
  const [localReviews, setLocalReviews] = useState(sol.reviews);

  function submitReview() {
    if (!newReview.text.trim()) return;
    setLocalReviews([...localReviews, {
      doctor:"Dr. You (verified)", spec:"Your Specialty", city:"Your City",
      rating:newReview.rating, text:newReview.text, vendor:newReview.vendor, date:"Just now"
    }]);
    setSubmitted(true);
  }

  const avg = (localReviews.reduce((s,r)=>s+r.rating,0)/localReviews.length).toFixed(1);

  return (
    <div>
      {/* Summary bar */}
      <div style={{ ...card(`rgba(${rgb(sol.color)},0.12)`), marginBottom:16, display:"flex", gap:20, alignItems:"center", flexWrap:"wrap" }}>
        <div style={{ textAlign:"center" }}>
          <div style={{ fontSize:36, fontWeight:900, color:sol.color }}>{avg}</div>
          <Stars rating={parseFloat(avg)} color={sol.color}/>
          <div style={{ fontSize:11, color:B.muted, marginTop:2 }}>{localReviews.length} doctor reviews</div>
        </div>
        <div style={{ flex:1 }}>
          {[5,4,3,2,1].map(star => {
            const count = localReviews.filter(r=>r.rating===star).length;
            const pct   = Math.round((count/localReviews.length)*100)||0;
            return (
              <div key={star} style={{ display:"flex", alignItems:"center", gap:8, marginBottom:4 }}>
                <span style={{ fontSize:11, color:B.muted, width:14 }}>{star}</span>
                <span style={{ color:"#F59E0B", fontSize:11 }}>★</span>
                <div style={{ flex:1, height:5, background:"rgba(255,255,255,0.07)", borderRadius:3 }}>
                  <div style={{ height:"100%", width:`${pct}%`, background:sol.color, borderRadius:3, transition:"width 0.5s" }}/>
                </div>
                <span style={{ fontSize:11, color:B.muted, width:24 }}>{count}</span>
              </div>
            );
          })}
        </div>
      </div>

      {/* Review cards */}
      <div style={{ display:"grid", gridTemplateColumns:isMobile?"1fr":"1fr 1fr", gap:11, marginBottom:18 }}>
        {localReviews.map((r,i) => (
          <div key={i} style={{ ...card(), padding:16 }}>
            <div style={{ display:"flex", justifyContent:"space-between", alignItems:"flex-start", marginBottom:8 }}>
              <div>
                <div style={{ fontSize:13, fontWeight:700 }}>{r.doctor}</div>
                <div style={{ fontSize:11, color:B.muted }}>{r.spec} · {r.city}</div>
              </div>
              <div style={{ textAlign:"right" }}>
                <Stars rating={r.rating} color={sol.color}/>
                <div style={{ fontSize:10, color:B.muted, marginTop:2 }}>{r.vendor} · {r.date}</div>
              </div>
            </div>
            <div style={{ fontSize:13, color:"#CBD5E1", lineHeight:1.6, fontStyle:"italic" }}>"{r.text}"</div>
          </div>
        ))}
      </div>

      {/* Write a review */}
      {!submitted ? (
        <div style={{ ...card(`rgba(${rgb(sol.color)},0.12)`), padding:18 }}>
          <div style={{ fontSize:13, fontWeight:700, marginBottom:14, color:sol.color }}>⭐ Write a Review</div>
          <div style={{ marginBottom:12 }}>
            <label style={{ fontSize:11, color:B.muted, display:"block", marginBottom:6 }}>Your Rating</label>
            <div style={{ display:"flex", gap:8 }}>
              {[1,2,3,4,5].map(s => (
                <button key={s} onClick={()=>setNewReview({...newReview,rating:s})} style={{ background:"none", border:"none", cursor:"pointer", fontSize:22, color:s<=newReview.rating?"#F59E0B":"rgba(255,255,255,0.15)", padding:0 }}>★</button>
              ))}
            </div>
          </div>
          <div style={{ marginBottom:12 }}>
            <label style={{ fontSize:11, color:B.muted, display:"block", marginBottom:5 }}>Vendor Used</label>
            <select value={newReview.vendor} onChange={e=>setNewReview({...newReview,vendor:e.target.value})} style={{ ...inp }}>
              {sol.vendors.map(v=><option key={v.name} value={v.name} style={{ background:"#0d1b2a" }}>{v.name}</option>)}
            </select>
          </div>
          <div style={{ marginBottom:14 }}>
            <label style={{ fontSize:11, color:B.muted, display:"block", marginBottom:5 }}>Your Experience</label>
            <textarea rows={3} placeholder="Share what worked well, what didn't, and who it's best suited for…" value={newReview.text} onChange={e=>setNewReview({...newReview,text:e.target.value})}
              style={{ ...inp, resize:"vertical" }}/>
          </div>
          <button onClick={submitReview} disabled={!newReview.text.trim()} style={{ ...btn(sol.color), opacity:newReview.text.trim()?1:0.4 }}>Submit Review →</button>
        </div>
      ) : (
        <div style={{ ...card(`rgba(${rgb(B.accent)},0.2)`), textAlign:"center", padding:24 }}>
          <div style={{ fontSize:32, marginBottom:8 }}>🙏</div>
          <div style={{ fontSize:14, fontWeight:700, color:B.accent }}>Thank you for your review!</div>
          <div style={{ fontSize:12, color:B.muted, marginTop:4 }}>Your feedback helps other doctors choose the right software.</div>
        </div>
      )}
    </div>
  );
}

